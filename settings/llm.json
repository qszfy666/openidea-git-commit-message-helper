{
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "OpenAI",
        "Anthropic",
        "DeepSeek",
        "Qwen",
        "Kimi",
        "GLM",
        "MiniMax",
        "SiliconFlow",
        "Volcengine",
        "Azure OpenAI",
        "OpenRouter",
        "Groq",
        "Mistral",
        "Ollama",
        "Magpie",
        "Custom"
      ],
      "title": "Provider preset",
      "group": "Provider",
      "default": "DeepSeek"
    },
    "protocol": {
      "type": "string",
      "enum": ["auto", "openai-chat", "openai-responses", "anthropic"],
      "title": "API protocol",
      "description": "auto follows the provider.",
      "group": "Provider",
      "default": "auto"
    },
    "baseUrl": {
      "type": "string",
      "title": "Base URL",
      "description": "Blank uses the provider preset.",
      "group": "Provider",
      "default": ""
    },
    "model": {
      "type": "string",
      "title": "Model",
      "description": "Blank uses the provider default.",
      "group": "Provider",
      "default": ""
    },
    "temperature": {
      "type": "number",
      "title": "Temperature",
      "group": "Sampling",
      "default": 0.5
    },
    "sendTemperature": {
      "type": "boolean",
      "title": "Send temperature",
      "description": "Turn off for models that reject the parameter. A request a model refuses because of temperature is retried without it either way.",
      "group": "Sampling",
      "default": true
    },
    "maxTokens": {
      "type": "integer",
      "title": "Max response tokens",
      "group": "Sampling",
      "default": 64000
    },
    "thinkingLevel": {
      "type": "string",
      "title": "Thinking level",
      "enum": ["DEFAULT", "DISABLED", "ENABLED", "LOW", "MEDIUM", "HIGH", "MAX"],
      "description": "DEFAULT sends no thinking parameter. Only levels the selected preset or mapping offers are sent.",
      "group": "Thinking",
      "default": "DEFAULT"
    },
    "thinkingPreset": {
      "type": "string",
      "title": "Thinking preset",
      "enum": ["model-default", "auto", "openai-effort", "nested-effort", "thinking-object", "enable-thinking", "anthropic-budget", "anthropic-adaptive", "custom"],
      "description": "model-default sends nothing. auto follows the protocol; the others are request-fragment templates. A blank Thinking mapping uses the preset template.",
      "group": "Thinking",
      "default": "model-default"
    },
    "thinkingMapping": {
      "type": "string",
      "title": "Thinking mapping",
      "multiline": true,
      "description": "Optional JSON keyed by level, e.g. {\"HIGH\":{\"reasoning_effort\":\"high\"}}. Overrides the preset template; clear it to restore the preset.",
      "group": "Thinking",
      "default": ""
    }
  }
}
