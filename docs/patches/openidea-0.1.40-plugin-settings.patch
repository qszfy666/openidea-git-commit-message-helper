+#[test]
+fn settings_upgrade_preserves_old_rows_and_opted_in_string_lists() {
+    let f = fixture(Limits::default());
+    let source = tempfile::tempdir().unwrap();
+    copy_dir(&sample("settings-pages"), source.path());
+    let path = source.path().join("llm.json");
+    let mut schema: serde_json::Value = serde_json::from_slice(&std::fs::read(&path).unwrap()).unwrap();
+    schema["properties"]["profiles"]["legacyStringKey"] = serde_json::json!("name");
+    std::fs::write(&path, serde_json::to_vec(&schema).unwrap()).unwrap();
+    f.install(source.path());
+    for old in [
+        serde_json::json!([{"name":"Existing", "provider":"openai", "model":"custom-model", "baseUrl":"https://example.com/v1"}]),
+        serde_json::json!(["Existing", "Second"]),
+        serde_json::json!("Existing, Second"),
+    ] {
+        f.workspace
+            .settings
+            .lock()
+            .insert("settings-pages".into(), serde_json::json!({"profiles":old}).as_object().unwrap().clone());
+        let result = f.run("settings-pages", "test", None).unwrap().unwrap();
+        let result: serde_json::Value = serde_json::from_str(&result).unwrap();
+        assert_eq!(result["profiles"][0]["name"], "Existing");
+        assert_eq!(result["profiles"][0]["limit"], 2048);
+        assert_eq!(result["profiles"][0]["enabled"], true);
+        if old[0].is_object() {
+            assert_eq!(result["profiles"][0]["model"], "custom-model");
+            assert_eq!(result["profiles"][0]["baseUrl"], "https://example.com/v1");
+        } else {
+            assert_eq!(result["profiles"][1]["name"], "Second");
+        }
+    }
+    for bad in [
+        serde_json::json!([{}]),
+        serde_json::json!([{"name":"Existing", "provider":"unknown"}]),
+        serde_json::json!([{"name":"Existing", "unexpected":true}]),
+    ] {
+        f.workspace
+            .settings
+            .lock()
+            .insert("settings-pages".into(), serde_json::json!({"profiles":bad}).as_object().unwrap().clone());
+        assert!(f.run("settings-pages", "test", None).is_err(), "invalid settings must still fail validation");
+    }
+}
