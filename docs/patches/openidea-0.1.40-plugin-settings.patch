+/** Upgrade stored shapes before applying the current schema's strict validation. */
+function normalizedSetting(s: SettingSchema, stored: unknown): unknown {
+  let value = stored;
+  if (s.type === "array" && s.items) {
+    if (typeof value === "string" && s.legacyStringKey)
+      value = value
+        .split(",")
+        .map((item) => item.trim())
+        .filter(Boolean);
+    if (!Array.isArray(value)) return undefined;
+    value = value.map((row) => {
+      if (typeof row === "string" && s.legacyStringKey)
+        row = { ...(s.items!.default as Record<string, unknown>), [s.legacyStringKey]: row.trim() };
+      return normalizedSetting(s.items!, row);
+    });
+  } else if (s.type === "object") {
+    if (!value || typeof value !== "object" || Array.isArray(value) || !Object.keys(value).length) return undefined;
+    value = { ...(s.default as Record<string, unknown>), ...value };
+  }
+  return accepts(s, value) ? value : undefined;
+}
